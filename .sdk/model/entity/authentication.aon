# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      format: "email"
      name: "email"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "User email address"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "User full name"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "newPassword"
      req: true
      short: "New password"
      type: "`$STRING`"
    }
    {
      format: "password"
      name: "password"
      req: true
      short: "User password"
      type: "`$STRING`"
    }
    {
      name: "referralCode"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Referral code to validate"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "token"
      req: true
      short: "Password reset token received via email"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/auth/login"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/password/recover"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "password"
            }
            {
              lit: "recover"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/password/reset"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "password"
            }
            {
              lit: "reset"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/referral/validate"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "referral"
            }
            {
              lit: "validate"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.referrer`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/signup"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "signup"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
