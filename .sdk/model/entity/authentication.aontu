# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: {
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: true
      sh: "User email address"
      t: "`$STRING`"
    }
    message: {
      h: "Message"
      n: "message"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "User full name"
      t: "`$STRING`"
    }
    newPassword: {
      fo: "password"
      h: "New Password"
      n: "newPassword"
      r: true
      sh: "New password"
      t: "`$STRING`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User password"
      t: "`$STRING`"
    }
    referralCode: {
      h: "Referral Code"
      n: "referralCode"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Referral code to validate"
      t: "`$STRING`"
    }
    referrer: {
      h: "Referrer"
      n: "referrer"
      r: false
      t: "`$OBJECT`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "JWT access token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
    valid: {
      h: "Valid"
      n: "valid"
      r: false
      t: "`$BOOLEAN`"
    }
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "email"
            "password"
          ]
          co: {
            id: "POST /api/auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/login"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "email"
          ]
          co: {
            id: "POST /api/auth/password/recover"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/password/recover"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "password"
            }
            {
              lit: "recover"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "newPassword"
            "token"
          ]
          co: {
            id: "POST /api/auth/password/reset"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/password/reset"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "password"
            }
            {
              lit: "reset"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "referralCode"
          ]
          co: {
            id: "POST /api/auth/referral/validate"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/referral/validate"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "referral"
            }
            {
              lit: "validate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "email"
            "name"
            "password"
            "referralCode"
          ]
          co: {
            id: "POST /api/auth/signup"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/signup"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "signup"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
